<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the watch: not to a cloud backup, and not in a transfer to a new device. The API
    key and the saved chat live in the app's private files. allowBackup="false" alone doesn't stop
    device-to-device transfer on Android 12 and later; these rules do.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
